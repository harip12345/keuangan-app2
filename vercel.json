{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/scan-nota.js": {
      "maxDuration": 60,
      "includeFiles": "api/lib/codex.gz",
      "excludeFiles": "node_modules/@openai/codex-linux-x64/**"
    },
    "api/telegram-webhook.js": {
      "maxDuration": 60,
      "includeFiles": "api/lib/codex.gz",
      "excludeFiles": "node_modules/@openai/codex-linux-x64/**"
    }
  }
}
